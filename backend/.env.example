# Copy this file to .env and edit as needed.
# docker-compose will automatically load .env from the project root.

# PostgreSQL connection string.
DATABASE_URL=postgresql://homeops:homeops@db:5432/homeops_grocery

# Directory where uploaded images are stored (inside the container).
DATA_DIR=/app/data

# Bind address and port for the FastAPI server.
APP_HOST=0.0.0.0
APP_PORT=8000
